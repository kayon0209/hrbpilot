# =============================================================================
# HRBP AI Workbench — Environment Variables Template
# Copy this to .env and fill in actual values. Never commit .env!
# =============================================================================

# --- Application ---
APP_NAME=hrbp-ai-workbench
APP_ENV=development           # development | staging | production
APP_PORT=8000
APP_DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://hrbp:hrbp_password@localhost:5432/hrbp_workbench
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=900

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-real-secret-key-at-least-32-characters
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ALGORITHM=HS256

# --- LLM (DeepSeek) ---
LLM_PROVIDER=deepseek          # zhipu | deepseek | openai | anthropic
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=                   # unused when LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Embedding (cloud-only, OpenAI-compatible) ---
# SiliconFlow:  https://api.siliconflow.cn/v1   model BAAI/bge-m3 (1024 dim)
# DashScope:    https://dashscope.aliyuncs.com/compatible-mode/v1  text-embedding-v3
# OpenAI:       https://api.openai.com/v1        text-embedding-3-small (1536 dim)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# --- Vector Database (Milvus) ---
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=19530
VECTOR_DB_TYPE=milvus
MILVUS_URI=                 # explicit override; empty -> http://{host}:{port}
MILVUS_COLLECTION=hrbp_chunks

# --- Object Storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hrbp-workbench
MINIO_SECURE=false

# --- Retrieval (hybrid RAG) ---
RRF_K=60
DENSE_TOP_K=20
SPARSE_TOP_K=20

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Guardrails ---
GUARDRAIL_PII_DETECTION_ENABLED=true
GUARDRAIL_PROMPT_INJECTION_ENABLED=true
GUARDRAIL_FACTUALITY_CHECK_ENABLED=true
GUARDRAIL_TOXICITY_DETECTION_ENABLED=true
GUARDRAIL_CONFIDENCE_THRESHOLD=0.65

# --- Rate Limiting ---
RATE_LIMIT_TENANT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json