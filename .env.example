# =============================================================================
# HRBP AI Workbench — Environment Variables Template
# Copy this to .env and fill in actual values. Never commit .env!
# =============================================================================

# --- Application ---
APP_NAME=hrbp-ai-workbench
APP_ENV=development           # development | staging | production
APP_PORT=8000
APP_DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://hrbp:hrbp_password@localhost:5432/hrbp_workbench
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=900         # 15 minutes

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-real-secret-key-at-least-32-characters
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ALGORITHM=HS256

# --- LLM (Zhipu GLM) ---
LLM_PROVIDER=zhipu           # zhipu | openai | anthropic | local
LLM_MODEL=glm-4              # glm-4 | glm-4-flash | glm-4-plus
LLM_API_KEY=your-zhipu-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# --- Embedding (Zhipu) ---
EMBEDDING_PROVIDER=zhipu     # zhipu | local | openai
EMBEDDING_MODEL=embedding-3  # Zhipu embedding model
EMBEDDING_API_KEY=           # defaults to LLM_API_KEY if empty
EMBEDDING_DIMENSION=2048
EMBEDDING_DEVICE=cpu          # cpu | cuda (only for local)

# --- Vector Database (Milvus) ---
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=19530
VECTOR_DB_TYPE=milvus         # milvus | qdrant

# --- Object Storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hrbp-workbench
MINIO_SECURE=false

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Guardrails ---
GUARDRAIL_PII_DETECTION_ENABLED=true
GUARDRAIL_PROMPT_INJECTION_ENABLED=true
GUARDRAIL_FACTUALITY_CHECK_ENABLED=true
GUARDRAIL_TOXICITY_DETECTION_ENABLED=true
GUARDRAIL_CONFIDENCE_THRESHOLD=0.65

# --- Rate Limiting ---
RATE_LIMIT_TENANT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2

# --- Logging ---
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text
