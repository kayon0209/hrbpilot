# HRBP AI Workbench — Docker environment (service names, not localhost)
# Copy to .env and edit before `docker compose up`.

# === Application ===
APP_ENV=production
APP_DEBUG=false

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://hrbp:hrbp_password@postgres:5432/hrbp_workbench
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL=900

# === Auth (REQUIRED: change in production) ===
JWT_SECRET=lEO26vohIjzLMEwT4J2d1SFV1/0jN7N6sEnayFSYbGaUUSLh4xg71DImrCrXYgED
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ALGORITHM=HS256

# === LLM — DeepSeek (REQUIRED) ===
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-0f61f7e9984649f0916fb1db7247d96e
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Embedding — cloud-only, OpenAI-compatible (SiliconFlow recommended) ===
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=58LDSVVWOY7URSFVGURDUNT9H9N3P0E2EHUNLSAS
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# === Vector Database (Milvus) ===
VECTOR_DB_HOST=milvus
VECTOR_DB_PORT=19530
VECTOR_DB_TYPE=milvus
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=hrbp_chunks

# === Object Storage (MinIO) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hrbp-workbench
MINIO_SECURE=false

# === Retrieval (hybrid RAG) ===
RRF_K=60
DENSE_TOP_K=20
SPARSE_TOP_K=20

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# === Guardrails ===
GUARDRAIL_PII_DETECTION_ENABLED=true
GUARDRAIL_PROMPT_INJECTION_ENABLED=true
GUARDRAIL_FACTUALITY_CHECK_ENABLED=true
GUARDRAIL_TOXICITY_DETECTION_ENABLED=true
GUARDRAIL_CONFIDENCE_THRESHOLD=0.65

# === Rate Limiting ===
RATE_LIMIT_TENANT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND_URL=redis://redis:6379/2

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json
