# HRBP AI Workbench — Docker environment
# Copy to backend/.env and edit before `docker compose up`

# === Application ===
APP_ENV=production
APP_DEBUG=false

# === Auth (REQUIRED: change in production) ===
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# === LLM — Primary: Zhipu GLM (REQUIRED) ===
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4
LLM_API_KEY=your-zhipu-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# === LLM — Fallback: DeepSeek (optional) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === LLM — Fallback: OpenAI (optional) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# === Embedding ===
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=2048

# === Guardrails ===
GUARDRAIL_CONFIDENCE_THRESHOLD=0.65

# === Rate Limiting ===
RATE_LIMIT_TENANT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json
